          "id": "heroui",
          "path": "skills/heroui/SKILL.md",
          "apply": "Use verified HeroUI primitives for React UI.",
          "instructions": [
            "Install the pinned React and styles packages. Read the matching local component documentation."
          ],
          "check": "Verify package versions, imports, browser components, and keyboard interaction."
        },
        {
          "id": "thesvg",
          "path": "skills/thesvg/SKILL.md",
          "apply": "Render real brand marks from the approved local catalogue.",
          "instructions": [
            "Declare brand slugs, retrieve each SVG, and render the exact asset with an accessible name."
          ],
          "check": "Verify SHA-256 on disk and in Chromium, or record why the brief needs no third-party marks."
        },
        {
          "id": "ui-ux-pro-max",
          "path": "skills/ui-ux-pro-max/SKILL.md",
          "apply": "Translate the brief into a small consistent design system.",
          "instructions": [
            "Define reusable tokens for surface, foreground, accent, type, spacing and interaction states. Resolve contrast and density before choosing ornamental details.",
            "Design the primary journey and include useful empty, loading, error and success states wherever the product actually needs them."
          ],
          "check": "Identify the tokens and interaction states implemented in code. Treat any unverified platform behavior as pending."
        },
        {
          "id": "web-accessibility",
          "path": "skills/web-accessibility/SKILL.md",
          "apply": "Implement and verify keyboard and screen-reader access to the primary flow.",
          "instructions": [
            "Use native elements and visible labels. Ensure meaningful accessible names, logical Tab order, visible focus, and announcements for relevant state changes.",
            "Exercise the primary flow by keyboard. Verify measured contrast, navigation landmarks, target size and reduced-motion behavior where applicable."
          ],
          "check": "Record keyboard steps and reported outcomes. Distinguish spot checks from a full accessibility audit."
        },
        {
          "id": "superpowers",
          "path": "skills/superpowers/SKILL.md",
          "apply": "Verify behavior with fresh evidence before claiming completion.",
          "instructions": [
            "For a defect, capture a reproducible failing case and trace its cause before patching. Exercise the same case after the patch.",
            "Run relevant existing checks and inspect current output. Report the exact evidence and name any checks that could not run."
          ],
          "check": "Report the executed check, result and any specific limitation."
        }
      ],
      "completionChecks": [],
      "evidence": "Open the actual page and inspect mobile, tablet and desktop. Exercise the primary path using keyboard and pointer, record console and overflow checks, and retest after corrections."
    },
